---
/**
 * ThemeToggle - Button to switch between light and dark themes.
 *
 * Uses sun/moon icons to indicate the current theme and allows
 * users to toggle between light and dark modes. Persists preference
 * to localStorage.
 */

interface Props {
  /** Additional CSS classes */
  class?: string;
}

const {class: className = ''} = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  aria-label="Toggle theme"
  id="theme-toggle-btn"
>
  <!-- Sun icon (shown in dark mode, click to switch to light) -->
  <svg
    class="theme-icon theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <!-- Moon icon (shown in light mode, click to switch to dark) -->
  <svg
    class="theme-icon theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background-color: var(--color-hover-overlay);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-icon {
    transition: transform 0.3s ease;
  }

  /* Sun icon - shown in dark mode */
  .theme-icon-sun {
    display: none;
  }

  /* Moon icon - shown in light mode */
  .theme-icon-moon {
    display: block;
  }

  :global(.dark) .theme-icon-sun {
    display: block;
  }

  :global(.dark) .theme-icon-moon {
    display: none;
  }

  /* Rotation animation on toggle */
  .theme-toggle:hover .theme-icon {
    transform: rotate(15deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-icon {
      transition: none;
    }

    .theme-toggle:hover .theme-icon {
      transform: none;
    }
  }
</style>

<script>
  import {toggleTheme} from '../lib/theme';

  function initThemeToggle(): void {
    const button = document.getElementById('theme-toggle-btn');

    if (!button) return;

    button.addEventListener('click', () => {
      const newTheme = toggleTheme();

      // Update aria-label based on new theme
      button.setAttribute(
        'aria-label',
        newTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );

      // Dispatch custom event for other components to react
      window.dispatchEvent(
        new CustomEvent('themechange', {detail: {theme: newTheme}})
      );
    });

    // Set initial aria-label based on current theme
    const isDark = document.documentElement.classList.contains('dark');
    button.setAttribute(
      'aria-label',
      isDark ? 'Switch to light theme' : 'Switch to dark theme'
    );
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }
</script>
