---
/**
 * Nav - Floating navigation bar that appears on scroll.
 *
 * Initially hidden, slides down after scrolling past the hero section.
 * Includes section links, theme toggle placeholder, and search placeholder.
 */

interface NavLink {
  href: string;
  label: string;
}

const navLinks: NavLink[] = [
  {href: '#introduction', label: 'Introduction'},
  {href: '#how-it-works', label: 'How It Works'},
  {href: '#data', label: 'Data'},
  {href: '#results', label: 'Results'},
  {href: '#replication', label: 'Replication'},
  {href: '#paper', label: 'Paper'},
];
---

<nav
  class="nav-container"
  id="main-nav"
  aria-label="Main navigation"
  data-visible="false"
>
  <div class="nav-content">
    <!-- Logo -->
    <a href="#" class="nav-logo" aria-label="BERTVision home">
      <span class="nav-logo-text">BERTVision</span>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="nav-links" role="list">
      {
        navLinks.map(link => (
          <li>
            <a href={link.href} class="nav-link" data-section={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right side actions -->
    <div class="nav-actions">
      <!-- Search button placeholder -->
      <button
        type="button"
        class="nav-action-btn"
        aria-label="Search"
        id="search-trigger"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>

      <!-- Theme toggle placeholder -->
      <button
        type="button"
        class="nav-action-btn"
        aria-label="Toggle theme"
        id="theme-toggle"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="theme-icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="theme-icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="nav-mobile-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        id="mobile-menu-trigger"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

<style>
  .nav-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease,
      background-color 0.3s ease,
      backdrop-filter 0.3s ease,
      box-shadow 0.3s ease;
    background-color: color-mix(in srgb, var(--color-bg-elevated) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .nav-container[data-visible='true'] {
    transform: translateY(0);
    opacity: 1;
  }

  /* Enhanced background when scrolled further */
  .nav-container[data-scrolled='true'] {
    background-color: var(--color-bg-elevated);
    box-shadow: var(--shadow-md);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .nav-content {
      padding: 0.75rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .nav-content {
      padding: 0.75rem 2rem;
    }
  }

  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1.125rem;
    transition: color 0.15s ease;
  }

  .nav-logo:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 1px;
    transition:
      width 0.2s ease,
      left 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background-color: var(--color-hover-overlay);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link.active::after {
    width: calc(100% - 1.5rem);
    left: 0.75rem;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-action-btn:hover {
    color: var(--color-text);
    background-color: var(--color-hover-overlay);
  }

  /* Theme toggle icons */
  .theme-icon-sun {
    display: none;
  }

  .theme-icon-moon {
    display: block;
  }

  :global(.dark) .theme-icon-sun {
    display: block;
  }

  :global(.dark) .theme-icon-moon {
    display: none;
  }

  .nav-mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: 0.375rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-mobile-btn:hover {
    color: var(--color-text);
    background-color: var(--color-hover-overlay);
  }

  @media (min-width: 1024px) {
    .nav-mobile-btn {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-container {
      transition: none;
    }

    .nav-logo,
    .nav-link,
    .nav-action-btn,
    .nav-mobile-btn {
      transition: none;
    }
  }
</style>

<script>
  import {toggleTheme} from '../lib/theme';

  /**
   * Navigation visibility controller.
   * Shows/hides the nav based on scroll position.
   */
  function initNav(): void {
    const navElement = document.getElementById('main-nav');
    const themeToggle = document.getElementById('theme-toggle');
    const mobileMenuTrigger = document.getElementById('mobile-menu-trigger');

    if (!navElement) return;

    // Store in const to help TypeScript understand it's non-null
    const nav = navElement;

    // Scroll threshold - show nav after scrolling past this point
    const SCROLL_THRESHOLD = window.innerHeight * 0.8;
    let isVisible = false;
    let ticking = false;

    function updateNavVisibility(): void {
      const shouldShow = window.scrollY > SCROLL_THRESHOLD;
      const isScrolledDeep = window.scrollY > SCROLL_THRESHOLD * 1.5;

      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        nav.dataset.visible = String(shouldShow);
      }

      // Update scrolled state for enhanced background
      nav.dataset.scrolled = String(isScrolledDeep);

      ticking = false;
    }

    function onScroll(): void {
      if (!ticking) {
        window.requestAnimationFrame(updateNavVisibility);
        ticking = true;
      }
    }

    // Smooth scroll to section on link click
    nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        const targetId = link.getAttribute('href');
        if (!targetId) return;

        const target = document.querySelector(targetId);
        if (target) {
          target.scrollIntoView({behavior: 'smooth'});
          // Update URL without triggering scroll
          history.pushState(null, '', targetId);
        }
      });
    });

    // Theme toggle
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        toggleTheme();
      });
    }

    // Mobile menu trigger
    if (mobileMenuTrigger) {
      mobileMenuTrigger.addEventListener('click', () => {
        const mobileNav = document.getElementById('mobile-nav');
        if (mobileNav) {
          const isOpen = mobileNav.dataset.open === 'true';
          mobileNav.dataset.open = String(!isOpen);
          mobileMenuTrigger.setAttribute('aria-expanded', String(!isOpen));

          // Lock body scroll when menu is open
          document.body.style.overflow = !isOpen ? 'hidden' : '';
        }
      });
    }

    // Active section tracking
    function updateActiveSection(): void {
      const sections = document.querySelectorAll('section[id]');
      let currentSection = '';

      sections.forEach(section => {
        const sectionTop = section.getBoundingClientRect().top;
        if (sectionTop < 200) {
          currentSection = '#' + section.id;
        }
      });

      nav.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach(link => {
        const isActive = link.getAttribute('href') === currentSection;
        link.classList.toggle('active', isActive);
      });
    }

    window.addEventListener('scroll', onScroll, {passive: true});
    window.addEventListener('scroll', updateActiveSection, {passive: true});

    // Initial check
    updateNavVisibility();
    updateActiveSection();
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>
