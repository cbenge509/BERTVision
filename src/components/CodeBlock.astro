---
/**
 * CodeBlock - Syntax-highlighted code block with copy-to-clipboard.
 *
 * Features:
 * - Syntax highlighting via CSS classes (compatible with Shiki/Prism)
 * - Copy-to-clipboard button with feedback
 * - Optional line numbers
 * - Light and dark mode styling
 */

interface Props {
  /** The code to display */
  code: string;
  /** Programming language for syntax highlighting */
  language?: string;
  /** Whether to show line numbers */
  showLineNumbers?: boolean;
  /** Optional filename to display */
  filename?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  code,
  language = 'text',
  showLineNumbers = false,
  filename,
  class: className = '',
} = Astro.props;

// Split code into lines for line number support
const lines = code.split('\n');
// Remove trailing empty line if present
if (lines.length > 0 && lines[lines.length - 1] === '') {
  lines.pop();
}
---

<div class:list={['code-block', className]} data-language={language}>
  {
    filename && (
      <div class="code-block-header">
        <span class="code-block-filename">{filename}</span>
      </div>
    )
  }

  <div class="code-block-container">
    <button
      type="button"
      class="code-block-copy"
      aria-label="Copy code to clipboard"
      data-code={code}
    >
      <svg
        class="copy-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
      </svg>
      <svg
        class="check-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="copy-text">Copy</span>
      <span class="copied-text">Copied!</span>
    </button>

    <pre
      class:list={['code-block-pre', {'with-line-numbers': showLineNumbers}]}><code class={`language-${language}`}>{
        showLineNumbers
          ? lines.map((line, i) => (
              <span class="code-line">
                <span class="line-number">{String(i + 1).padStart(String(lines.length).length, ' ')}</span>
                <span class="line-content">{line}</span>
              </span>
            ))
          : code
      }</code></pre>
  </div>
</div>

<style>
  .code-block {
    position: relative;
    margin: 1rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--color-code-bg);
    border: 1px solid var(--color-border);
  }

  .code-block-header {
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background-color: var(--color-bg-tertiary);
    border-bottom: 1px solid var(--color-border);
  }

  .code-block-filename {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .code-block-container {
    position: relative;
  }

  .code-block-copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease,
      color 0.15s ease;
    z-index: 1;
  }

  .code-block:hover .code-block-copy,
  .code-block-copy:focus {
    opacity: 1;
  }

  .code-block-copy:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
  }

  .code-block-copy .check-icon,
  .code-block-copy .copied-text {
    display: none;
  }

  .code-block-copy[data-copied='true'] .copy-icon,
  .code-block-copy[data-copied='true'] .copy-text {
    display: none;
  }

  .code-block-copy[data-copied='true'] .check-icon,
  .code-block-copy[data-copied='true'] .copied-text {
    display: block;
  }

  .code-block-copy[data-copied='true'] {
    color: #22c55e;
  }

  .code-block-pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-code-text);
    background: transparent;
    border-radius: 0;
  }

  .code-block-pre.with-line-numbers {
    padding-left: 0;
  }

  .code-block-pre code {
    padding: 0;
    background: transparent;
    border-radius: 0;
    font-size: inherit;
    color: inherit;
  }

  .code-line {
    display: block;
  }

  .line-number {
    display: inline-block;
    width: 3rem;
    padding-right: 1rem;
    text-align: right;
    color: var(--color-text-muted);
    user-select: none;
    border-right: 1px solid var(--color-border);
    margin-right: 1rem;
  }

  .line-content {
    display: inline;
  }

  /* Syntax highlighting tokens (Shiki/Prism compatible) */
  .code-block :global(.token.comment),
  .code-block :global(.token.prolog),
  .code-block :global(.token.doctype),
  .code-block :global(.token.cdata) {
    color: #6b7280;
  }

  .code-block :global(.token.punctuation) {
    color: #9ca3af;
  }

  .code-block :global(.token.property),
  .code-block :global(.token.tag),
  .code-block :global(.token.boolean),
  .code-block :global(.token.number),
  .code-block :global(.token.constant),
  .code-block :global(.token.symbol) {
    color: #ef4444;
  }

  .code-block :global(.token.selector),
  .code-block :global(.token.attr-name),
  .code-block :global(.token.string),
  .code-block :global(.token.char),
  .code-block :global(.token.builtin) {
    color: #22c55e;
  }

  .code-block :global(.token.operator),
  .code-block :global(.token.entity),
  .code-block :global(.token.url),
  .code-block :global(.language-css .token.string),
  .code-block :global(.style .token.string) {
    color: #f59e0b;
  }

  .code-block :global(.token.atrule),
  .code-block :global(.token.attr-value),
  .code-block :global(.token.keyword) {
    color: #8b5cf6;
  }

  .code-block :global(.token.function),
  .code-block :global(.token.class-name) {
    color: #3b82f6;
  }

  .code-block :global(.token.regex),
  .code-block :global(.token.important),
  .code-block :global(.token.variable) {
    color: #f97316;
  }

  /* Dark mode syntax highlighting */
  :global(.dark) .code-block :global(.token.comment),
  :global(.dark) .code-block :global(.token.prolog),
  :global(.dark) .code-block :global(.token.doctype),
  :global(.dark) .code-block :global(.token.cdata) {
    color: #9ca3af;
  }

  :global(.dark) .code-block :global(.token.punctuation) {
    color: #d1d5db;
  }

  :global(.dark) .code-block :global(.token.property),
  :global(.dark) .code-block :global(.token.tag),
  :global(.dark) .code-block :global(.token.boolean),
  :global(.dark) .code-block :global(.token.number),
  :global(.dark) .code-block :global(.token.constant),
  :global(.dark) .code-block :global(.token.symbol) {
    color: #f87171;
  }

  :global(.dark) .code-block :global(.token.selector),
  :global(.dark) .code-block :global(.token.attr-name),
  :global(.dark) .code-block :global(.token.string),
  :global(.dark) .code-block :global(.token.char),
  :global(.dark) .code-block :global(.token.builtin) {
    color: #4ade80;
  }

  :global(.dark) .code-block :global(.token.operator),
  :global(.dark) .code-block :global(.token.entity),
  :global(.dark) .code-block :global(.token.url),
  :global(.dark) .code-block :global(.language-css .token.string),
  :global(.dark) .code-block :global(.style .token.string) {
    color: #fbbf24;
  }

  :global(.dark) .code-block :global(.token.atrule),
  :global(.dark) .code-block :global(.token.attr-value),
  :global(.dark) .code-block :global(.token.keyword) {
    color: #a78bfa;
  }

  :global(.dark) .code-block :global(.token.function),
  :global(.dark) .code-block :global(.token.class-name) {
    color: #60a5fa;
  }

  :global(.dark) .code-block :global(.token.regex),
  :global(.dark) .code-block :global(.token.important),
  :global(.dark) .code-block :global(.token.variable) {
    color: #fb923c;
  }

  @media (prefers-reduced-motion: reduce) {
    .code-block-copy {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Initialize copy-to-clipboard functionality for all code blocks.
   */
  function initCodeBlocks(): void {
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('.code-block-copy');

    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.dataset.code;
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);

          // Show success state
          button.dataset.copied = 'true';
          button.setAttribute('aria-label', 'Copied!');

          // Reset after delay
          setTimeout(() => {
            button.dataset.copied = 'false';
            button.setAttribute('aria-label', 'Copy code to clipboard');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);

          // Fallback for older browsers
          const textarea = document.createElement('textarea');
          textarea.value = code;
          textarea.style.position = 'absolute';
          textarea.style.left = '-9999px';
          document.body.appendChild(textarea);
          textarea.select();

          try {
            document.execCommand('copy');
            button.dataset.copied = 'true';
            setTimeout(() => {
              button.dataset.copied = 'false';
            }, 2000);
          } finally {
            document.body.removeChild(textarea);
          }
        }
      });
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodeBlocks);
  } else {
    initCodeBlocks();
  }
</script>
