{
  "name": "bertvision",
  "version": "1.0.0",
  "description": "BERTVision - Parameter-efficient QA and text classification using BERT hidden state activations",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "gts lint",
    "fix": "gts fix",
    "format": "prettier --write .",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbenge509/BERTVision.git"
  },
  "keywords": [
    "bert",
    "nlp",
    "machine-learning",
    "question-answering"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cbenge509/BERTVision/issues"
  },
  "homepage": "https://cbenge509.github.io/BERTVision/",
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "astro": "^5.16.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint-plugin-astro": "^1.5.0",
    "gts": "^7.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
